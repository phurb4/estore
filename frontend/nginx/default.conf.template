# Nginx server config, rendered at container start by the image's envsubst
# step. NGINX_ENVSUBST_FILTER restricts it to API_BASE_URL, PRODUCTS_UPSTREAM
# and ORDERS_UPSTREAM, so Nginx's own variables ($uri, $api_origin, ...) are
# left untouched. The browser talks only to this server: /api/products and
# /api/orders are forwarded to the services (single entry point, no CORS).

# Origin (scheme + host + port) of the API, derived from API_BASE_URL.
# Empty when API_BASE_URL is a relative path: 'self' already covers it.
map "${API_BASE_URL}" $api_origin {
    default "";
    "~^(?<origin>https?://[^/]+)" $origin;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    autoindex off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers. Declared only at server level: an add_header inside a
    # location would drop these (Nginx does not merge them).
    # Concessions / pending:
    #  - style-src 'unsafe-inline': the template uses style="" attributes.
    #  - TODO: add integrity + crossorigin to the CDN <script>/<link> tags.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://ajax.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://use.fontawesome.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://use.fontawesome.com; img-src 'self' data:; connect-src 'self' $api_origin; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Runtime config rendered from config.js.template (see Dockerfile).
    location = /config.js {
        alias /etc/nginx/conf.d/config.js;
        default_type application/javascript;
        expires -1;
    }

    # API gateway. Exact paths and methods only: nothing else is forwarded.
    # Do not add add_header inside these blocks (it would drop the security
    # headers declared above).
    location = /api/products {
        limit_except GET { deny all; }
        proxy_pass ${PRODUCTS_UPSTREAM}/products;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location = /api/orders {
        limit_except POST { deny all; }
        client_max_body_size 8k;
        proxy_pass ${ORDERS_UPSTREAM}/orders;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
