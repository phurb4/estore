# Nginx server config, rendered at container start by the image's envsubst
# step. NGINX_ENVSUBST_FILTER restricts it to API_BASE_URL, PRODUCTS_UPSTREAM,
# ORDERS_UPSTREAM and COGNITO_UPSTREAM, so Nginx's own variables ($uri,
# $api_origin, ...) are left untouched. The browser talks only to this server:
# /api/products, /api/orders and /idp are forwarded (single entry point, no
# CORS).

# Origin (scheme + host + port) of the API, derived from API_BASE_URL.
# Empty when API_BASE_URL is a relative path: 'self' already covers it.
map "${API_BASE_URL}" $api_origin {
    default "";
    "~^(?<origin>https?://[^/]+)" $origin;
}

# Origin of the Cognito endpoint, same idea. Empty for a same-origin path
# (/idp with the emulator) or when no endpoint is set; the official Cognito
# address must be listed here for the browser to reach it.
map "${COGNITO_ENDPOINT}" $cognito_origin {
    default "";
    "~^(?<cog_origin>https://[^/]+)" $cog_origin;
}

# Rate limit for /api/orders only (never /api/products). One bucket per client
# address: 30 requests per minute with a burst of 10. NOTE: behind Docker or a load balancer the address
# seen here is the proxy's, not the customer's; real client IPs (real_ip) are
# configured with the Ingress in the Kubernetes step. The per-customer cap is
# enforced by the Orders service (ORDERS_MAX_PER_HOUR).
limit_req_zone $binary_remote_addr zone=orders:1m rate=30r/m;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    autoindex off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers. Declared only at server level: an add_header inside a
    # location would drop these (Nginx does not merge them).
    # Concessions / pending:
    #  - style-src 'unsafe-inline': the template uses style="" attributes.
    #  - TODO: add integrity + crossorigin to the CDN <script>/<link> tags.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://ajax.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://use.fontawesome.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://use.fontawesome.com; img-src 'self' data:; connect-src 'self' $api_origin $cognito_origin; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Runtime config rendered from config.js.template (see Dockerfile).
    location = /config.js {
        alias /etc/nginx/conf.d/config.js;
        default_type application/javascript;
        expires -1;
    }

    # API gateway. Exact paths and methods only: nothing else is forwarded.
    # Do not add add_header inside these blocks (it would drop the security
    # headers declared above).
    location = /api/products {
        limit_except GET { deny all; }
        proxy_pass ${PRODUCTS_UPSTREAM}/products;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # GET = order history, POST = new order. The Authorization header (Cognito
    # access token) is forwarded as is; Nginx never inspects or logs it. Over
    # the limit: 429.
    location = /api/orders {
        limit_except GET POST { deny all; }
        limit_req zone=orders burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;
        proxy_pass ${ORDERS_UPSTREAM}/orders;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # Cognito emulator (Floci) behind the same origin: the browser never talks
    # to Floci directly, so no CORS and no extra address in connect-src. Only
    # POST (the Cognito API is JSON over POST to a single URL); every other
    # method, including OPTIONS, is denied. Not used with real AWS, where the
    # library calls the official Cognito endpoint.
    location = /idp {
        limit_except POST { deny all; }
        client_max_body_size 8k;
        proxy_pass ${COGNITO_UPSTREAM}/;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # Scripts and styles are revalidated on every load (Cache-Control: no-cache,
    # answered with 304 when unchanged), so a rebuilt image is never hidden by a
    # stale browser copy. expires, not add_header: see the note above.
    location ~* \.(?:js|css)$ {
        expires -1;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
